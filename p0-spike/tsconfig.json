{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // tool-probe.ts reaches into hearth-app/src/lib by relative path so it
    // runs the app's real tool definitions rather than a copy. tsx executes
    // this package directly — nothing here is ever compiled to JS.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
